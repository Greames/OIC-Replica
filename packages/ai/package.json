{
  "name": "@oicr/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@oicr/adapters": "workspace:*",
    "@oicr/db": "workspace:*",
    "@oicr/flow-schema": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "jsonata": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "tsx": "^4.20.0"
  }
}
