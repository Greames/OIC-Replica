{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_POOL_MAX",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "ANTHROPIC_API_KEY",
    "AUTH_RATE_LIMIT",
    "PW_CHROMIUM_PATH",
    "E2E_NO_SERVER",
    "CI",
    "SECRETS_KEY",
    "ALLOW_PRIVATE_NETWORK",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "APP_URL",
    "TELEGRAM_API_BASE",
    "WORKER_CONCURRENCY",
    "SCHEDULER_TICK_MS",
    "STALE_RUN_MINUTES",
    "SYNC_TIMEOUT_SECONDS",
    "MOCK_API_PORT",
    "PORT",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_MODEL",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_MODEL",
    "GEMINI_BASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_BASE_URL",
    "AI_*"
  ]
}
