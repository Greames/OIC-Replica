# Copy to .env (docker compose) and apps/web/.env.local (pnpm dev).

DATABASE_URL=postgres://oicr:oicr@localhost:5432/oicr
# The application must connect as a role that is not a superuser and has no BYPASSRLS, or
# tenant isolation does not apply (refused in production). Migrations and the job queue may
# use the owner role:
# MIGRATION_DATABASE_URL=postgres://owner:…@host:5432/oicr
# QUEUE_DATABASE_URL=postgres://owner:…@host:5432/oicr
# APP_DB_PASSWORD=…   # with an owner allowed to manage roles, migrate gives oicr_app this login

# Better Auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Customer credentials (connection secrets, channel settings) live in Vault, never in
# Postgres. docker compose runs a local Vault and wires it up; to use your own:
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_KV_MOUNT=oicr                 # KV v2 engine; policy: tenants/* under it
# VAULT_ROLE_ID= / VAULT_SECRET_ID=   # AppRole, or VAULT_K8S_ROLE for Kubernetes auth,
# VAULT_TOKEN=                        # or a token (VAULT_TOKEN_FILE to read it from a file)
# VAULT_NAMESPACE=                    # Vault Enterprise / HCP
# VAULT_CACHE_TTL_MS=60000            # how long services keep a credential in memory

# Development without Vault (`pnpm dev`): credentials are encrypted into the dev_secrets
# table with this key. Refused when NODE_ENV=production. Generate: openssl rand -base64 32
# Also needed once to move credentials from a pre-v2 database into Vault.
SECRETS_KEY=

# Tracing (OpenTelemetry). Off unless set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=1           # share of new traces kept (0..1)
# OTEL_TRACES_EXPORTER=console        # print spans instead, for debugging

# Stream engine (apps/stream): serves the trigger URLs /t/...; the web app forwards to it.
# STREAM_URL=http://localhost:3001    # where the web app finds it
# STREAM_PORT=3001
# STREAM_MAX_IN_FLIGHT=1000           # requests handled at once by one instance
# STREAM_DRAIN_SECONDS=25             # time given to in-flight requests on shutdown

# Per-tenant limits by tier (a tenant's own row in tenant_limits overrides them):
# concurrent queued runs, concurrent sync requests, trigger requests per second.
# TIER_STANDARD_RUNS=4  TIER_STANDARD_SYNC=16  TIER_STANDARD_RPS=50
# TIER_BUSINESS_RUNS=16 TIER_BUSINESS_SYNC=64  TIER_BUSINESS_RPS=200
# TIER_DEDICATED_RUNS=64 TIER_DEDICATED_SYNC=256 TIER_DEDICATED_RPS=1000

# Batch engine (apps/batch): runs integrations with pipeline steps.
# BATCH_CONCURRENCY=2                 # runs at once per instance
# BATCH_THREADS=2                     # transform worker threads per pipeline (default: CPUs - 1, max 4)
# BATCH_TRANSFORM_TIMEOUT_SECONDS=120 # longest one chunk's transform may take
# BATCH_HEARTBEAT_SECONDS=20          # how often a running batch run reports it is alive
# BATCH_STALE_SECONDS=120             # quiet longer than this: the run is resumed from its checkpoint
# BATCH_MAX_ATTEMPTS=3                # resumes before a run fails
# BATCH_DRAIN_SECONDS=30              # on shutdown, time for running chunks before leaving them to resume

# Circuit breaker per tenant and connection
# BREAKER_FAILURES=5                  # consecutive retryable failures before pausing calls
# BREAKER_OPEN_SECONDS=30             # pause before a probe call is let through

# Optional: "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the app, used in links in notifications (defaults to BETTER_AUTH_URL)
APP_URL=

# Email for notify steps and email channels (optional; without it they are skipped)
RESEND_API_KEY=
EMAIL_FROM=

# Worker
WORKER_CONCURRENCY=4

# AI builder: Gemini, Claude or GPT. Set one key; with several, AI_PROVIDER picks
# (gemini | anthropic | openai), else Gemini, then Claude, then GPT.
# Without a key the rest of the app works; the AI builder is off.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=gemini
# Models (defaults: gemini-4-argon, claude-opus-5-5, gpt-6-astra). AI_MODEL overrides the active one.
# GEMINI_MODEL=gemini-4-argon
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6-astra
# Reasoning effort for all providers: low | medium | high | xhigh | max
# AI_EFFORT=high
# AI_SESSION_TOKEN_LIMIT=3000000

# Lets connections reach localhost / private IPs: local development, or a self-hosted install
# next to the databases it loads (docker compose passes it to web, stream, worker and batch).
# ALLOW_PRIVATE_NETWORK=true

# Test only. Never set in production.
# AUTH_RATE_LIMIT=off
