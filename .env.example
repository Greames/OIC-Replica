# Copy to .env (docker compose) and apps/web/.env.local (pnpm dev).

DATABASE_URL=postgres://oicr:oicr@localhost:5432/oicr

# Better Auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encrypts connection credentials. Generate with: openssl rand -base64 32
# Keep it safe: if it changes, stored credentials must be entered again.
SECRETS_KEY=

# Optional: "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payload storage (used from phase 1). MinIO locally, R2/S3 in production.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=oicr-payloads
S3_ACCESS_KEY=oicr
S3_SECRET_KEY=oicr-secret

# Email for notify steps (optional; without it they are skipped)
RESEND_API_KEY=
EMAIL_FROM=

# Worker
WORKER_CONCURRENCY=4

# AI builder. Without a key the rest of the app works; the AI builder is off.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5, effort high)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high
# AI_SESSION_TOKEN_LIMIT=3000000

# Local development only: lets connections reach localhost / private IPs.
# ALLOW_PRIVATE_NETWORK=true

# Test only. Never set in production.
# AUTH_RATE_LIMIT=off
