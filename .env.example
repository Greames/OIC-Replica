# Copy to .env (docker compose) and apps/web/.env.local (pnpm dev).

DATABASE_URL=postgres://oicr:oicr@localhost:5432/oicr

# Better Auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payload storage (used from phase 1). MinIO locally, R2/S3 in production.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=oicr-payloads
S3_ACCESS_KEY=oicr
S3_SECRET_KEY=oicr-secret

# AI builder (phase 2)
ANTHROPIC_API_KEY=

# Test only. Never set in production.
# AUTH_RATE_LIMIT=off
