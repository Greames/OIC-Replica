# Copy to .env (docker compose) and apps/web/.env.local (pnpm dev).

DATABASE_URL=postgres://oicr:oicr@localhost:5432/oicr

# Better Auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Customer credentials (connection secrets, channel settings) live in Vault, never in
# Postgres. docker compose runs a local Vault and wires it up; to use your own:
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_KV_MOUNT=oicr                 # KV v2 engine; policy: tenants/* under it
# VAULT_ROLE_ID= / VAULT_SECRET_ID=   # AppRole, or VAULT_K8S_ROLE for Kubernetes auth,
# VAULT_TOKEN=                        # or a token (VAULT_TOKEN_FILE to read it from a file)
# VAULT_NAMESPACE=                    # Vault Enterprise / HCP
# VAULT_CACHE_TTL_MS=60000            # how long services keep a credential in memory

# Development without Vault (`pnpm dev`): credentials are encrypted into the dev_secrets
# table with this key. Refused when NODE_ENV=production. Generate: openssl rand -base64 32
# Also needed once to move credentials from a pre-v2 database into Vault.
SECRETS_KEY=

# Tracing (OpenTelemetry). Off unless set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=1           # share of new traces kept (0..1)
# OTEL_TRACES_EXPORTER=console        # print spans instead, for debugging

# Optional: "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the app, used in links in notifications (defaults to BETTER_AUTH_URL)
APP_URL=

# Email for notify steps and email channels (optional; without it they are skipped)
RESEND_API_KEY=
EMAIL_FROM=

# Worker
WORKER_CONCURRENCY=4

# AI builder: Gemini, Claude or GPT. Set one key; with several, AI_PROVIDER picks
# (gemini | anthropic | openai), else Gemini, then Claude, then GPT.
# Without a key the rest of the app works; the AI builder is off.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=gemini
# Models (defaults: gemini-4-argon, claude-opus-5-5, gpt-6-astra). AI_MODEL overrides the active one.
# GEMINI_MODEL=gemini-4-argon
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6-astra
# Reasoning effort for all providers: low | medium | high | xhigh | max
# AI_EFFORT=high
# AI_SESSION_TOKEN_LIMIT=3000000

# Local development only: lets connections reach localhost / private IPs.
# ALLOW_PRIVATE_NETWORK=true

# Test only. Never set in production.
# AUTH_RATE_LIMIT=off
